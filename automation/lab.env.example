# lab.env – all names, addresses and versions of the homelab in one place.
#
#   cp lab.env.example lab.env     # then adjust lab.env to your environment
#
# lab.env is ignored by git. Passwords and other secrets are NOT stored here:
# the scripts ask for them when they need them.
#
# Every value can be overridden for a single run, e.g.
#   TEMPLATE_ID=9001 ./01-proxmox/create-template.sh

# --- 01 Proxmox: cloud-init template -------------------------------------------
# Run on: Proxmox host (root)
PVE_STORAGE="${PVE_STORAGE:-vm-storage}"   # storage for VM disks
PVE_BRIDGE="${PVE_BRIDGE:-k8snet}"               # SDN VNet of the cluster (MTU 1450)

TEMPLATE_ID="${TEMPLATE_ID:-9000}"
TEMPLATE_NAME="${TEMPLATE_NAME:-ubuntu2404-k8s-tpl}"
IMAGE_URL="${IMAGE_URL:-https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img}"
IMAGE_FILE="${IMAGE_FILE:-/root/ubuntu-24.04-server-cloudimg-amd64.img}"
BAKE_PACKAGES="${BAKE_PACKAGES:-qemu-guest-agent,chrony}"   # empty = skip virt-customize

VM_CORES="${VM_CORES:-8}"
VM_MEMORY="${VM_MEMORY:-16384}"        # MB, no ballooning
VM_DISK_SIZE="${VM_DISK_SIZE:-120G}"
# CPU type of the VMs. x86-64-v3 runs on every Intel CPU since Haswell and every AMD CPU
# since Zen, so the VMs can be live-migrated between hosts with different CPUs. "host"
# passes the features of the current host through: after a live migration to an older
# CPU, Java services (Keycloak, OX) crash with SIGILL (doc 01, section 4.7).
VM_CPU_TYPE="${VM_CPU_TYPE:-x86-64-v3}"

CI_USER="${CI_USER:-k8s}"              # never "kube": Kubespray uses that as a system user
DNS_SERVER="${DNS_SERVER:-10.240.0.1}"
# Public keys that may log in to every node (space-separated)
SSH_PUBKEYS="${SSH_PUBKEYS:-/root/.ssh/id_rsa.pub /root/.ssh/k8s_ansible.pub}"

# --- 02 Kubernetes nodes and Kubespray -----------------------------------------
# Run on: Proxmox host (clone-nodes.sh), all other scripts on the kubespray VM (user k8s)
GATEWAY="${GATEWAY:-10.240.0.1}"
NET_PREFIX="${NET_PREFIX:-24}"
NODE_MTU="${NODE_MTU:-1450}"           # MTU of the VM network (VXLAN SDN)

# One node per line: name:vmid:ip:role   (role = control | worker | both)
# node6 was added later (doc 06); for a new build it can simply be listed here.
# A new worker is one more line here (role worker), then automation/06-add-worker/.
NODES="${NODES:-
master:201:10.240.0.21:control
node1:202:10.240.0.22:worker
node2:203:10.240.0.23:worker
node3:204:10.240.0.24:worker
node4:205:10.240.0.25:worker
node5:206:10.240.0.26:worker
node6:207:10.240.0.27:worker
}"

KUBESPRAY_VERSION="${KUBESPRAY_VERSION:-v2.32.0}"
KUBESPRAY_DIR="${KUBESPRAY_DIR:-$HOME/kubespray}"
KUBESPRAY_VENV="${KUBESPRAY_VENV:-$HOME/kubespray-venv}"
INVENTORY_NAME="${INVENTORY_NAME:-mycluster}"     # ~/kubespray/inventory/<name>
ANSIBLE_USER="${ANSIBLE_USER:-$CI_USER}"
CALICO_MTU="${CALICO_MTU:-1400}"                  # NODE_MTU minus 50 bytes of Calico encapsulation
KUBECONFIG_PATH="${KUBECONFIG_PATH:-$HOME/.kube/config}"

# --- 03 Platform services and openDesk -----------------------------------------
# Run on: kubespray VM (k8s)
# The names below are the neutral names used in the documentation – set your own
# domain names here; lab.env stays on your machine and is never committed.
DOMAIN="${DOMAIN:-k8s.lab}"                # openDesk domain; AD DNS: *.k8s.lab and k8s.lab -> LB_IP
AD_DOMAIN="${AD_DOMAIN:-lab.local}"        # Active Directory domain
AD_DC_IP="${AD_DC_IP:-10.240.0.234}"       # domain controller, DNS for DOMAIN and AD_DOMAIN
LB_IP="${LB_IP:-10.240.0.190}"             # MetalLB address of HAProxy Ingress
LB_RANGE="${LB_RANGE:-10.240.0.190-10.240.0.199}"   # exclude this range in DHCP!

HELM_VERSION="${HELM_VERSION:-v3.22.0}"
HELMFILE_VERSION="${HELMFILE_VERSION:-1.7.3}"
HELM_DIFF_VERSION="${HELM_DIFF_VERSION:-v3.11.0}"
YQ_VERSION="${YQ_VERSION:-v4.53.3}"
METALLB_VERSION="${METALLB_VERSION:-0.16.1}"
LONGHORN_VERSION="${LONGHORN_VERSION:-1.12.1}"
HAPROXY_INGRESS_VERSION="${HAPROXY_INGRESS_VERSION:-0.16.1}"
CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.21.1}"

OPENDESK_VERSION="${OPENDESK_VERSION:-v1.17.2}"
OPENDESK_REPO="${OPENDESK_REPO:-https://gitlab.opencode.de/bmi/opendesk/deployment/opendesk.git}"
OPENDESK_DIR="${OPENDESK_DIR:-$HOME/opendesk}"
OPENDESK_ENV="${OPENDESK_ENV:-dev}"
OPENDESK_NAMESPACE="${OPENDESK_NAMESPACE:-opendesk}"
# The master password is generated once and never stored in the repository
MASTER_PASSWORD_FILE="${MASTER_PASSWORD_FILE:-$HOME/opendesk-master-password.txt}"
ETCD_BACKUP_DIR="${ETCD_BACKUP_DIR:-$HOME/backups/etcd}"

# --- 04 Active Directory, file server and single sign-on ----------------------
# Run on: kubespray VM (k8s); the PowerShell scripts in windows/ on the DC and FS
AD_DC_HOST="${AD_DC_HOST:-AD-DC}"               # host name of the DC: AD_DC_HOST.AD_DOMAIN
AD_NETBIOS="${AD_NETBIOS:-INTERN}"
AD_ADMIN_USER="${AD_ADMIN_USER:-administrator}" # only for scp from the DC (fetch-ad-files.sh)
AD_USER_OU="${AD_USER_OU:-OU=Benutzer,OU=Firma}"   # relative to the domain DN (DC=…)
AD_GROUP_OU="${AD_GROUP_OU:-OU=Gruppen,OU=Firma}"
AD_GROUP_PREFIX="${AD_GROUP_PREFIX:-G-}"        # only these groups are imported (AGDLP: global groups)
AD_ROOT_CA_FILE="${AD_ROOT_CA_FILE:-$HOME/intern-root-ca.pem}"
TEST_ACCOUNTS_FILE="${TEST_ACCOUNTS_FILE:-$HOME/testkonten.txt}"
# Optional for the checks: expected number of imported users and groups (empty = only > 0).
# The number of users changes with every change in AD, so it is empty by default.
AD_EXPECTED_USERS="${AD_EXPECTED_USERS:-}"
AD_EXPECTED_GROUPS="${AD_EXPECTED_GROUPS:-22}"
SVC_IMPORT="${SVC_IMPORT:-svc-nubus-import}"    # service accounts in AD
SVC_SMB="${SVC_SMB:-svc-nextcloud}"
SVC_KEYCLOAK="${SVC_KEYCLOAK:-svc-keycloak}"

FS_HOST="${FS_HOST:-FS}"
FS_IP="${FS_IP:-10.240.0.223}"
SMB_SHARES="${SMB_SHARES:-Allgemein Austausch Abteilungen Projekte}"
SMB_CSI_VERSION="${SMB_CSI_VERSION:-1.20.3}"
NC_UID="${NC_UID:-101}"                         # uid/gid of the Nextcloud container
# Mount list for Nextcloud: nc-mounts.sh, enable-fileshare-groups.sh, verify-nextcloud-files.sh
# and ops/post-rollout.sh. Keep your own list outside the repository, e.g. $HOME/nc-mounts.csv.
NC_MOUNTS_CSV="${NC_MOUNTS_CSV:-$AUTOMATION_DIR/04-identity/manifests/nc-mounts.csv}"

NUBUS_OU="${NUBUS_OU:-intern-ad}"               # target OU of the Directory Importer in Nubus
NUBUS_BASE_DN="${NUBUS_BASE_DN:-dc=swp-ldap,dc=internal}"
# Only after the Administrator password was changed in the portal (doc 03, section 13):
# a file with the current password (chmod 600) for scripts that run unattended. Without
# it, scripts ask for the password when the one from the installation no longer works.
NUBUS_ADMIN_PASSWORD_FILE="${NUBUS_ADMIN_PASSWORD_FILE:-}"
DIRECTORY_IMPORTER_VERSION="${DIRECTORY_IMPORTER_VERSION:-1.7.2}"

IDP_HOST="${IDP_HOST:-idp}"                     # dedicated Keycloak: https://IDP_HOST.DOMAIN/auth
IDP_REALM="${IDP_REALM:-intern}"
IDP_CLIENT="${IDP_CLIENT:-opendesk}"
IDP_KEY="${IDP_KEY:-internIdP}"                 # key in the openDesk configuration
IDP_DISPLAY_NAME="${IDP_DISPLAY_NAME:-Anmeldung mit AD-Konto}"
# Login page of the dedicated Keycloak (doc 04, section 19.5)
IDP_LOGIN_THEME="${IDP_LOGIN_THEME-opendesk}"   # copy of the openDesk design; empty = Keycloak default page
IDP_LOCALE="${IDP_LOCALE-de}"                   # language of the login page; empty = English only
# yes = openDesk skips its own login form and sends everyone straight to the login page
# above – nobody types the AD password into the openDesk form any more, where it cannot
# work. Local openDesk accounts (e.g. the Nubus Administrator) then have no login form:
# set "no", run configure-sso.sh --force and roll out opendesk-keycloak-bootstrap.
IDP_ENFORCE="${IDP_ENFORCE:-yes}"
KEYCLOAKX_VERSION="${KEYCLOAKX_VERSION:-7.3.1}"
KEYCLOAK_DB_SIZE="${KEYCLOAK_DB_SIZE:-8Gi}"
KEYCLOAK_DB_PASSWORD_FILE="${KEYCLOAK_DB_PASSWORD_FILE:-$HOME/keycloak-db-password.txt}"
KEYCLOAK_ADMIN_PASSWORD_FILE="${KEYCLOAK_ADMIN_PASSWORD_FILE:-$HOME/keycloak-admin-password.txt}"
OPENDESK_CA_FILE="${OPENDESK_CA_FILE:-$HOME/opendesk-ca.crt}"   # written by 03-opendesk/export-ca.sh

# --- 05 OX App Suite ------------------------------------------------------------
# The openDesk mail domain must match the mail addresses in AD: "Login with AD
# account" links the accounts by email address (doc 05, section 4.1).
MAIL_DOMAIN="${MAIL_DOMAIN:-$AD_DOMAIN}"
GROUPWARE_GROUP="${GROUPWARE_GROUP:-managed-by-attribute-Groupware}"

# --- ops: daily check ------------------------------------------------------------
# Known exceptions for ops/daily-check.sh: deployments that are at 0 replicas on
# purpose and services that have no endpoints on purpose. Regex on namespace/name,
# e.g. "opendesk/(name-a|name-b)". Empty = no exceptions.
DAILY_IGNORE="${DAILY_IGNORE:-}"
